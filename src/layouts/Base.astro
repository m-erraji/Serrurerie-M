---
// Tokens for retained area/legal cards, followed by the brand theme.
import '@awc-ui/core/css/tokens.css';
import '../styles/global.css';

import Seo from '../components/Seo.astro';
import LocksmithJsonLd from '../components/LocksmithJsonLd.astro';
import Analytics from '../components/Analytics.astro';
import Header from '../components/Header.astro';

import Footer from '../components/Footer.astro';
import WhatsAppFab from '../components/WhatsAppFab.astro';
import { DEMO, type Lang } from '../config/site';
import { t, dir, type PageId } from '../i18n/utils';

interface Props {
  lang: Lang;
  page: PageId;
  title: string;
  description: string;
  /** Quartier pour le message WhatsApp pré-rempli. */
  zone?: string;
}
const { lang, page, title, description, zone } = Astro.props;
const d = t(lang);

const fonts =
  'https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600;700&family=Manrope:wght@400;500;600;700&display=swap';
const arabicFont = 'https://fonts.googleapis.com/css2?family=Noto+Sans+Arabic:wght@400;700&display=optional';
---

<!doctype html>
<html lang={lang} dir={dir(lang)} data-theme="light">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="theme-color" content="#203b32" />
    <meta name="format-detection" content="telephone=no" />
    {DEMO && <meta name="robots" content="noindex, nofollow" />}
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <!-- Polices non bloquantes ; les fontes système restent utilisables hors ligne. -->
    <link rel="preload" as="style" href={fonts} />
    <link rel="stylesheet" href={fonts} media="print" onload="this.media='all'" />
    <noscript><link rel="stylesheet" href={fonts} /></noscript>
    {lang === 'ar' && <link rel="stylesheet" href={arabicFont} media="print" onload="this.media='all'" />}
    <Seo lang={lang} page={page} title={title} description={description} />
    <LocksmithJsonLd lang={lang} />
    <Analytics />
  </head>
  <body>
    <a class="skip-link" href="#main">{d.a11y.skip}</a>
    <Header lang={lang} page={page} />

    <main id="main" tabindex="-1">
      <slot />
    </main>
    <Footer lang={lang} page={page} />
    <WhatsAppFab lang={lang} zone={zone} />

    <script>
      import '../scripts/awc';
    </script>
  </body>
</html>
