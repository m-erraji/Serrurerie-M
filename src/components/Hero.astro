---
import Icon from './Icon.astro';
import { site, type Lang } from '../config/site';
import { t, telHref, waHref } from '../i18n/utils';
import { design } from '../i18n/design';
interface Props { lang: Lang; title?: string; zone?: string; }
const { lang, title, zone } = Astro.props;
const d = t(lang), c = design[lang];
---
<section class="hero" aria-labelledby="hero-title"><div class="container hero__grid">
  <div class="hero__copy"><p class="eyebrow"><span></span>{c.eyebrow}</p><h1 id="hero-title">{title ?? c.title}{!title && <em>{c.accent}</em>}</h1><p class="hero__intro">{c.intro}</p>
    <div class="hero__actions"><a class="button" href={telHref} data-cta="hero"><Icon name="phone" size={19}/>{d.hero.callNow}<Icon name="chevron" size={16}/></a><a class="button button--outline" href={waHref(lang,zone)} target="_blank" rel="noopener noreferrer" data-cta="hero"><Icon name="whatsapp" size={20}/>{d.contact.whatsapp}</a></div>
    <p class="hero__note"><Icon name="check" size={17}/>{site.trust[0].text[lang]}</p><a class="hero__discover" href="#services">{c.discover}<span aria-hidden="true">↓</span></a>
  </div>
  <div class="hero__visual"><img class="hero__photo" src="/images/photos/door-handle.jpg" alt={c.imageAlt} width="933" height="1400" fetchpriority="high"/><div class="hero__image-caption"><span>01 / MARRAKECH</span><p>{c.imageNote}</p></div><div class="hero__badge"><span class="hero__badge-icon"><Icon name="shield" size={27}/></span><div><strong>{site.responseTime[lang]}</strong><span>{site.hours.label[lang]}</span></div></div></div>
</div></section>
