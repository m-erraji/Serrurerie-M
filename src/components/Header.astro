---
import Icon from './Icon.astro';
import { site, LANGS, type Lang } from '../config/site';
import { t, pathFor, telHref, dicts, type PageId } from '../i18n/utils';
import { design } from '../i18n/design';
interface Props { lang: Lang; page: PageId; }
const { lang, page } = Astro.props;
const d = t(lang), c = design[lang];
const home = pathFor({ kind: 'home' }, lang);
const links = [{ label: c.home, href: home }, { label: d.rail.services, href: home + '#services' }, { label: c.expertise, href: home + '#approach' }, { label: d.rail.zones, href: home + '#zones' }];
---
<div class="topbar"><div class="container topbar__inner"><span><Icon name="map-pin" size={14} />{c.local}</span><span><i class="status-dot"></i>{site.availability[lang]}</span></div></div>
<header class="site-header">
  <div class="container header__inner">
    <a class="logo" href={home} aria-label={d.a11y.home}><span class="logo__mark"><Icon name="key" size={28} /></span><span class="logo__text">Serrurerie<span>MARRAKECH</span></span></a>
    <nav class="desktop-nav" aria-label={d.a11y.sections}>{links.map(link => <a href={link.href}>{link.label}</a>)}</nav>
    <div class="header__actions">
      <details class="language-picker"><summary aria-label={d.a11y.language}><Icon name="globe" size={17}/><span>{lang.toUpperCase()}</span><Icon name="chevron" size={12}/></summary><nav aria-label={d.a11y.language}>{LANGS.map(l => <a href={pathFor(page,l)} lang={l} hreflang={l} aria-current={l === lang ? 'page' : undefined}>{dicts[l].langName}</a>)}</nav></details>
      <a class="button button--small header-call" href={telHref} data-cta="header"><Icon name="phone" size={17}/><span class="num">{site.phone.display}</span></a>
      <button class="menu-toggle" aria-expanded="false" aria-controls="mobile-nav" aria-label={c.menu} data-open-label={c.menu} data-close-label={c.close}><span></span><span></span><span></span></button>
    </div>
  </div>
  <nav id="mobile-nav" class="mobile-nav" aria-label={d.a11y.sections} hidden>{links.map(link => <a href={link.href}>{link.label}<Icon name="chevron" size={16}/></a>)}<a href={home+'#contact'}>{d.rail.contact}<Icon name="phone" size={16}/></a></nav>
</header>
<noscript><style>.menu-toggle{display:none}.mobile-nav[hidden]{display:block!important}@media(min-width:1050px){.mobile-nav[hidden]{display:none!important}}</style></noscript>
<script>
const toggle = document.querySelector<HTMLButtonElement>('.menu-toggle');
const nav = document.getElementById('mobile-nav');
const close = () => { if(toggle && nav) { toggle.setAttribute('aria-expanded','false'); toggle.setAttribute('aria-label',toggle.dataset.openLabel!); nav.hidden = true; } };
toggle?.addEventListener('click', () => { if(!nav) return; const open = toggle.getAttribute('aria-expanded') !== 'true'; toggle.setAttribute('aria-expanded',String(open)); toggle.setAttribute('aria-label',(open ? toggle.dataset.closeLabel : toggle.dataset.openLabel)!); nav.hidden = !open; });
nav?.querySelectorAll('a').forEach(a => a.addEventListener('click',close));
document.addEventListener('keydown',e => { if(e.key === 'Escape') { if(toggle?.getAttribute('aria-expanded') === 'true') { close(); toggle.focus(); } document.querySelectorAll<HTMLDetailsElement>('.language-picker[open]').forEach(el => { el.open = false; el.querySelector('summary')?.focus(); }); } });
document.addEventListener('click',e => { document.querySelectorAll<HTMLDetailsElement>('.language-picker[open]').forEach(el => { if(!el.contains(e.target as Node)) el.open = false; }); });
window.matchMedia('(min-width: 1050px)').addEventListener('change',e => { if(e.matches) close(); });
</script>
