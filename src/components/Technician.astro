---
import Icon from './Icon.astro';
import { site, type Lang } from '../config/site';
import { t } from '../i18n/utils';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const d = t(lang);
const { firstName, photo, yearsExperience } = site.technician;
---

<section class="section" aria-labelledby="tech-title">
  <div class="container">
    <div class="section__head">
      <h2 id="tech-title">{d.technician.title}</h2>
    </div>

    <md-card variant="filled" class="tech">
      {
        photo ? (
          <md-avatar class="tech__avatar" src={photo} alt={d.technician.photoAlt} size="large" loading="lazy" />
        ) : (
          <div class="tech__photo-ph" role="img" aria-label={d.technician.photoPlaceholder}>
            <Icon name="user" size={40} />
            <span class="ph">{d.technician.photoPlaceholder}</span>
          </div>
        )
      }
      <div class="tech__body">
        <h3>{firstName || <span class="ph">{d.technician.namePlaceholder}</span>}</h3>
        <p class="tech__xp">
          {yearsExperience ? d.technician.experience(yearsExperience) : <span class="ph">{d.technician.experiencePlaceholder}</span>}
        </p>
        <p class="tech__text">{d.technician.text}</p>
      </div>
    </md-card>
  </div>
</section>

<style>
  .tech {
    --md-card-container-color: var(--c-bg-card);
    --md-card-padding: 20px;
    display: grid;
    gap: 20px;
    align-items: center;
  }

  .tech__avatar {
    --md-avatar-size: 128px;
  }

  .tech__photo-ph {
    display: grid;
    place-items: center;
    align-content: center;
    gap: 8px;
    inline-size: 128px;
    block-size: 128px;
    padding: 8px;
    border: 2px dashed var(--c-placeholder);
    border-radius: 50%;
    color: var(--c-muted);
    text-align: center;
    font-size: 0.8rem;
    line-height: 1.2;
  }

  .tech__xp {
    margin-block: 4px 8px;
    color: var(--c-accent);
    font: 700 1.1rem/1.3 var(--font-title);
  }

  .tech__text {
    color: var(--c-muted);
  }

  @media (min-width: 560px) {
    .tech {
      grid-template-columns: auto 1fr;
    }
  }
</style>
