---
import Icon from './Icon.astro';
import { site, LANGS, type Lang } from '../config/site';
import { t, pathFor, dicts, type PageId } from '../i18n/utils';
import { design } from '../i18n/design';
interface Props { lang: Lang; page: PageId; }
const { lang, page } = Astro.props;
const d = t(lang), c = design[lang];
const home = pathFor({kind:'home'},lang);
---
<footer class="site-footer"><div class="container"><div class="footer__main">
  <div class="footer__brand"><a class="logo" href={home}><span class="logo__mark"><Icon name="key" size={26}/></span><span class="logo__text">Serrurerie<span>MARRAKECH</span></span></a><p>{c.footerText}</p></div>
  <nav class="footer__nav" aria-label={d.a11y.sections}><a href={home+'#services'}>{d.rail.services}</a><a href={home+'#zones'}>{d.rail.zones}</a><a href={home+'#faq'}>{d.rail.faq}</a><a href={home+'#contact'}>{d.rail.contact}</a></nav>
  <div class="footer__hours"><span>{d.footer.hours}</span><p>{site.hours.label[lang]}</p><p>{d.footer.zoneValue}</p></div>
</div><div class="footer__bottom"><p>© {new Date().getFullYear()} {site.name}. {c.rights}</p><a href={pathFor({kind:'legal'},lang)}>{c.legal}</a><nav class="footer__langs" aria-label={d.footer.languages}>{LANGS.map(l => <a href={pathFor(page,l)} hreflang={l} lang={l} aria-current={l === lang ? 'page' : undefined}>{dicts[l].langName}</a>)}</nav></div></div></footer>
