---
import Icon from './Icon.astro';
import { site, type Lang } from '../config/site';
import { t, telHref, waHref, pathFor, type AreaSlug } from '../i18n/utils';
import { design } from '../i18n/design';
interface Props { lang: Lang; current?: AreaSlug; }
const { lang, current } = Astro.props;
const d = t(lang), c = design[lang];
const pages = site.zones.filter(z => z.page && z.page !== current);
---
<section id="zones" class="section zones-section" aria-labelledby="zones-title"><div class="container zones__grid">
  <div class="zones__copy"><p class="eyebrow">{c.zonesEyebrow}</p><h2 id="zones-title">{c.zonesTitle}</h2><p class="section__lead">{c.zonesText}</p><p class="zones__hint">{d.zones.hint}</p><ul class="chips" role="list">{site.zones.map(z => <li><a href={waHref(lang,z.name[lang])} target="_blank" rel="noopener noreferrer" data-cta="zones"><Icon name="map-pin" size={15}/>{z.name[lang]}</a></li>)}</ul><p class="zones__more">{d.zones.notListed} <a class="num" href={telHref}>{site.phone.display}</a></p></div>
  <div class="zones__visual"><img src="/images/photos/marrakech.jpg" width="1200" height="800" loading="lazy" alt={c.cityAlt}/><div class="zones__caption"><Icon name="map-pin" size={20}/><span>Marrakech · مراكش</span></div></div>
  {pages.length > 0 && <nav class="zones__pages" aria-label={d.zones.pagesTitle}>{pages.map(z => <a href={pathFor({kind:'area',slug:z.page!},lang)}>{d.zones.pageLink(z.name[lang])}<Icon name="chevron" size={15}/></a>)}</nav>}
</div></section>
