---
import Icon from './Icon.astro';
import type { Lang } from '../config/site';
import { t, waHref, telHref } from '../i18n/utils';
interface Props { lang: Lang; zone?: string; }
const { lang, zone } = Astro.props;
const d = t(lang);
---
<div class="mobile-contact-bar"><a href={telHref} data-cta="mobile"><Icon name="phone" size={18}/>{d.hero.callNow}</a><a href={waHref(lang,zone)} target="_blank" rel="noopener noreferrer" data-cta="fab"><Icon name="whatsapp" size={21}/>{d.fab.label}</a></div><a class="wa-fab" href={waHref(lang,zone)} target="_blank" rel="noopener noreferrer" data-cta="fab" aria-label={d.fab.aria}><Icon name="whatsapp" size={25}/></a>
