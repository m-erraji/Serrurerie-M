---
import { site, type Lang } from '../config/site';
import { t, absolute, alternates, pathFor, type PageId } from '../i18n/utils';

interface Props {
  lang: Lang;
  page: PageId;
  title: string;
  description: string;
}
const { lang, page, title, description } = Astro.props;
const d = t(lang);
const canonical = absolute(pathFor(page, lang));
const others = (['fr', 'en', 'ar'] as Lang[]).filter((l) => l !== lang);
---

<title>{title}</title>
<meta name="description" content={description} />
<link rel="canonical" href={canonical} />
{alternates(page).map((a) => <link rel="alternate" hreflang={a.hreflang} href={a.href} />)}

<meta property="og:type" content="website" />
<meta property="og:site_name" content={site.name} />
<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
<meta property="og:url" content={canonical} />
<meta property="og:image" content={absolute('/og-image.png')} />
<meta property="og:image:width" content="1200" />
<meta property="og:image:height" content="630" />
<meta property="og:locale" content={d.ogLocale} />
{others.map((l) => <meta property="og:locale:alternate" content={t(l).ogLocale} />)}
<meta name="twitter:card" content="summary_large_image" />
