---
import Icon from './Icon.astro';
import type { Lang } from '../config/site';
import { t } from '../i18n/utils';
import { design } from '../i18n/design';
interface Props { lang: Lang; }
const { lang } = Astro.props;
const d = t(lang), c = design[lang];
const icons = ['phone','route','check'] as const;
---
<section class="section steps-section" aria-labelledby="steps-title"><div class="container"><div class="section__head centered"><p class="eyebrow">{c.stepsEyebrow}</p><h2 id="steps-title">{c.stepsTitle}</h2></div><ol class="steps">{d.steps.items.map((step,i) => <li><div class="step__top"><span class="step__num">0{i+1}</span><Icon name={icons[i]} size={25}/></div><h3>{step.title}</h3><p>{step.text}</p></li>)}</ol></div></section>
