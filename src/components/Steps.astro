---
import Icon from './Icon.astro';
import type { Lang } from '../config/site';
import { t } from '../i18n/utils';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const d = t(lang);
const icons = ['phone', 'route', 'check'] as const;
---

<section class="section section--alt" aria-labelledby="steps-title">
  <div class="container">
    <div class="section__head">
      <h2 id="steps-title">{d.steps.title}</h2>
    </div>

    <ol class="steps">
      {
        d.steps.items.map((step, i) => (
          <li>
            <md-card variant="outlined" class="step">
              <div class="step__top">
                <span class="step__num num" aria-hidden="true">{i + 1}</span>
                <Icon name={icons[i]} size={26} class="step__icon" />
              </div>
              <h3>{step.title}</h3>
              <p>{step.text}</p>
            </md-card>
          </li>
        ))
      }
    </ol>
  </div>
</section>

<style>
  .steps {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 16px;
  }

  .steps li {
    display: flex;
  }

  .step {
    --md-card-container-color: var(--c-bg);
    --md-card-outline-color: var(--c-line);
    --md-card-padding: 20px;
    display: block;
    inline-size: 100%;
  }

  .step__top {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-block-end: 12px;
  }

  .step__num {
    font: 800 3rem/1 var(--font-title);
    color: var(--c-accent);
  }

  .step__icon {
    color: var(--c-muted);
  }

  .step h3 {
    margin-block-end: 6px;
  }

  .step p {
    color: var(--c-muted);
  }

  @media (min-width: 760px) {
    .steps {
      grid-template-columns: repeat(3, 1fr);
    }
  }
</style>
