---
import Icon from './Icon.astro';
import { site, type Lang } from '../config/site';
import { t, telHref, waHref } from '../i18n/utils';

interface Props {
  lang: Lang;
  zone?: string;
}
const { lang, zone } = Astro.props;
const d = t(lang);
---

<section id="contact" class="section contact" aria-labelledby="contact-title">
  <div class="container">
    <div class="section__head">
      <h2 id="contact-title">{d.contact.title}</h2>
      <p class="section__lead">{d.contact.lead}</p>
    </div>

    <md-card variant="filled" class="contact__card">
      <a class="contact__number num" href={telHref} data-cta="contact">{site.phone.display}</a>
      <p class="contact__intl">
        {d.contact.international} <span class="num">{site.phone.international}</span>
      </p>

      <div class="contact__actions">
        <md-button variant="filled" size="md" href={telHref} data-cta="contact">
          <Icon slot="leading-icon" name="phone" />
          {d.contact.call}
        </md-button>
        <md-button class="btn-wa" variant="filled" size="md" href={waHref(lang, zone)} target="_blank" data-cta="contact">
          <Icon slot="leading-icon" name="whatsapp" />
          {d.contact.whatsapp}
        </md-button>
        <!-- Révélé par le script client seulement si le presse-papiers est disponible. -->
        <md-button id="copy-number" variant="outlined" size="md" data-number={site.phone.display} hidden>
          <Icon slot="leading-icon" name="copy" />
          {d.contact.copy}
        </md-button>
      </div>
    </md-card>
  </div>
</section>

<md-snackbar id="copy-toast" message={d.contact.copied} position="bottom-start"></md-snackbar>

<style>
  .contact__card {
    --md-card-container-color: var(--c-bg-card);
    --md-card-padding: 24px 20px;
    display: grid;
    gap: 8px;
  }

  .contact__number {
    justify-self: start;
    font: 800 clamp(2.4rem, 12vw, 4rem) / 1.05 var(--font-title);
    color: var(--c-text);
    text-decoration: none;
    letter-spacing: 0.02em;
  }

  [dir='rtl'] .contact__number {
    justify-self: end;
  }

  .contact__intl {
    color: var(--c-muted);
  }

  .contact__actions {
    display: grid;
    gap: 12px;
    margin-block-start: 16px;
  }

  .contact__actions md-button {
    inline-size: 100%;
  }

  .contact__actions md-button[hidden] {
    display: none;
  }

  @media (min-width: 640px) {
    .contact__actions {
      grid-template-columns: repeat(3, max-content);
    }

    .contact__actions md-button {
      inline-size: auto;
    }
  }
</style>
