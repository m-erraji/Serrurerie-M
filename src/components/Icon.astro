const directional = new Set(['chevron']);

const { name, size = 24, slot, class: cls } = Astro.props;
const classes = ['icon', directional.has(name) && 'icon--dir', cls].filter(Boolean).join(' ');
---

<svg
  class={classes}
  slot={slot}
  width={size}
  height={size}
  viewBox="0 0 24 24"
  fill="none"
  style="fill: none"
  stroke="currentColor"
  stroke-width="2"
  stroke-linecap="round"
  stroke-linejoin="round"
  aria-hidden="true"
  focusable="false"
  set:html={icons[name]}
/>
