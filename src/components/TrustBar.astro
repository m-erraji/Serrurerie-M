---
import Icon from './Icon.astro';
import { site, type Lang } from '../config/site';
import { t } from '../i18n/utils';
interface Props { lang: Lang; }
const { lang } = Astro.props;
---
<section class="trust" aria-label={t(lang).trust.title}><ul class="container trust__list" role="list">{site.trust.map(item => <li><span class="trust__icon"><Icon name={item.icon as any} size={24}/></span><span>{item.text[lang]}</span></li>)}</ul></section>
