---
import Icon from './Icon.astro';
import { site, type Lang } from '../config/site';
import { t } from '../i18n/utils';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const d = t(lang);
---

<section class="trust" aria-label={d.trust.title}>
  <div class="container">
    <md-card variant="outlined" class="trust__card">
      <ul class="trust__list">
        {
          site.trust.map((item) => (
            <li>
              <span class="trust__icon">
                <Icon name={item.icon as any} size={22} />
              </span>
              <span>{item.text[lang]}</span>
            </li>
          ))
        }
      </ul>
    </md-card>
  </div>
</section>

<style>
  .trust {
    padding-block: 8px 8px;
  }

  .trust__card {
    --md-card-container-color: var(--c-bg-raised);
    --md-card-outline-color: var(--c-line);
    --md-card-padding: 4px 16px;
    display: block;
  }

  .trust__list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
  }

  .trust__list li {
    display: flex;
    align-items: center;
    gap: 12px;
    padding-block: 12px;
    font-weight: 600;
  }

  .trust__list li + li {
    border-block-start: 1px solid var(--c-line);
  }

  .trust__icon {
    display: grid;
    place-items: center;
    flex: none;
    inline-size: 40px;
    block-size: 40px;
    border-radius: 50%;
    background: rgb(255 122 48 / 0.14);
    color: var(--c-accent);
  }

  @media (min-width: 900px) {
    .trust__list {
      grid-template-columns: repeat(3, 1fr);
      gap: 16px;
    }

    .trust__list li + li {
      border-block-start: 0;
    }
  }
</style>
