---
import { DEMO, type Lang } from '../config/site';
import { demo } from '../config/demo';
import { t, telHref } from '../i18n/utils';
import { design } from '../i18n/design';
import Icon from './Icon.astro';
interface Props { lang: Lang; }
const { lang } = Astro.props;
const d = t(lang), c = design[lang];
const items = d.faq.items.map((item,i) => ({q:item.q,a:DEMO ? demo.faqAnswers[lang][i] : item.a}));
---
<section id="faq" class="section" aria-labelledby="faq-title"><div class="container faq__grid"><div class="faq__intro"><p class="eyebrow">{c.faqEyebrow}</p><h2 id="faq-title">{c.faqTitle}</h2><p class="section__lead">{c.faqText}</p><a class="text-link" href={telHref}><Icon name="phone" size={18}/>{d.hero.callNow}</a></div><div class="faq">{items.map(item => <details name="faq"><summary>{item.q}<span class="faq__plus" aria-hidden="true">+</span></summary><p class:list={['faq__answer',item.a.startsWith('[') && 'ph']}>{item.a}</p></details>)}</div></div></section>
